# ============================================================
# GENHEX — Environment Variables
# Copy to .env.local (never commit .env.local). Populate from
# Supabase Project Settings → API, and Google Cloud Console
# for OAuth client credentials.
# ============================================================

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used exclusively by lib/supabase/service-role.ts for the small set of
# privileged operations that intentionally bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
